# plantsight 設定。建議用 ./setup.sh（Windows：雙擊 start.cmd）產生 .env，密碼與金鑰會自動填好，只問要接哪個模型。

# ─── 模型（接你們自己的 AI）────────────────────────────────────────────
# anthropic：Claude 官方 API
# foundry：Microsoft Foundry 上的 Claude（LLM_FOUNDRY_RESOURCE 填資源名稱，模型名稱填部署名稱）
# openai_compatible：Azure OpenAI（v1 端點）、vLLM、Ollama 等 Chat Completions 相容端點
# 沒填 LLM_API_KEY 也能啟動：總覽、資料品質、稽核照常可用，只有數據助理會提示尚未設定
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_BASE_URL=
LLM_FOUNDRY_RESOURCE=
LLM_MODEL_FAST=claude-haiku-5-5
LLM_MODEL_STRONG=claude-sonnet-5-5
# openai_compatible 的推理模型（例如 Ollama qwen3.5）建議設 none，避免 token 全花在思考
LLM_REASONING_EFFORT=

# ─── 密碼與金鑰（必填；setup 腳本會自動產生）─────────────────────────
POSTGRES_PASSWORD=
JWT_SECRET=
# 所有示範帳號共用的密碼
SEED_DEMO_PASSWORD=

# ─── 網路 ──────────────────────────────────────────────────────────────
# 網頁入口：http://localhost:3100（和 hr360 的 3000 錯開，兩個專案可以同時跑）
WEB_PORT=3100
WEB_BIND=127.0.0.1
API_PORT=8370
DB_PORT=5435
# 在主機上直接跑 API 或測試時才用得到；Docker 內會自動改成連 db 容器
DATABASE_URL=postgresql+psycopg://plantsight:CHANGE_ME@localhost:5435/plantsight

# 示範資料的基準日（「上個月」＝2026-10）
APP_TODAY=2026-11-10
